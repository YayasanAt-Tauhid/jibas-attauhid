# Salin ke .env lalu isi nilainya. Prefix EXPO_PUBLIC_ wajib agar Expo
# meng-inject nilainya ke bundle aplikasi (sama seperti VITE_ di web).
# Gunakan publishable key baru (sb_publishable_...), BUKAN anon key JWT lama.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL portal web yang sudah ter-deploy — dipakai checkout in-app untuk
# memanggil API route /api/portal/checkout (pembuatan transaksi Midtrans).
EXPO_PUBLIC_PORTAL_WEB_URL=
