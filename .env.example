# Salin ke .env lalu isi nilainya. JANGAN commit .env.

# ─── Runtime server aplikasi (TanStack Start server functions) ───
# Dibaca oleh server functions di src/server/* (menggantikan Supabase Edge Functions).
# Set nilai ini di host tempat aplikasi berjalan (VPS/Cloudflare), bukan hanya di .env lokal.
SUPABASE_URL=https://rumdeqkrtfjxckqgokoy.supabase.co
SUPABASE_ANON_KEY=            # anon/publishable key (verifikasi JWT user)
SUPABASE_SERVICE_ROLE_KEY=    # service-role key — WAJIB, akses penuh DB (bypass RLS)

# Midtrans (pembayaran online) — dipakai src/server/payment.ts & route api.midtrans-notification
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Opsional: daftar channel pembayaran Snap yang diaktifkan, dipisah koma
# (mis. "credit_card,gopay,other_qris"). Kosongkan untuk pakai default (semua channel).
# Sesuaikan jika sebagian channel dinonaktifkan Midtrans (mis. saat fitur
# "Split Midtrans fee with customers" diaktifkan di dashboard Midtrans).
# Catatan: channel key QRIS generik di Snap adalah "other_qris", BUKAN "qris".
MIDTRANS_ENABLED_PAYMENTS=

# Gateway notifikasi — dipakai src/server/notifikasi.ts
TELEGRAM_BOT_TOKEN=
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=             # opsional

# ─── Scripts migrasi (bukan runtime aplikasi) ───
SUPABASE_ACCESS_TOKEN=        # PAT dari https://supabase.com/dashboard/account/tokens
SUPABASE_DB_PASSWORD=
# MariaDB jbsfina (untuk migrasi_jurnal.py di VPS)
DB_HOST=localhost
DB_NAME=jbsfina
DB_USER=
DB_PASS=
